# Optional. When set, unreadable documents can be filled by an OpenAI-compatible model.
# The approval rules stay in code either way. Leave these blank to run fully offline.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional hosted OCR. Only pages without a text layer, and uploaded images,
# are sent to Gemini Flash for transcription and field extraction.
# VENDORFLOW_OCR=on
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT=60
# 200 DPI is a fast default; raise it to 300 only for unusually small or degraded text.
# VENDORFLOW_OCR_DPI=200
# VENDORFLOW_OCR_MIN_KV_CONFIDENCE=0.6
