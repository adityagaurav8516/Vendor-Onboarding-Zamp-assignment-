# Optional. When set, unreadable documents can be filled by an OpenAI-compatible model.
# The approval rules stay in code either way. Leave these blank to run fully offline.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional OCR (pip install -r requirements-ocr.txt). Only pages without a text
# layer, and uploaded images, are sent to PaddleOCR.
# VENDORFLOW_OCR=on
# VENDORFLOW_OCR_LANG=en
# Faster defaults for upright business documents. Raise DPI to 300 only for
# unusually small or degraded text; leave a model blank to use PaddleOCR's default.
# VENDORFLOW_OCR_DPI=200
# VENDORFLOW_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
# VENDORFLOW_OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
# VENDORFLOW_OCR_MIN_KV_CONFIDENCE=0.6
